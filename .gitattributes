# Line endings that matter: Windows batch files need CRLF, shell scripts need LF everywhere
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.sh    text eol=lf

# Media, models and fonts are binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.mp4   binary
*.mp3   binary
*.wav   binary
*.m4a   binary
*.onnx  binary
*.glb   binary
*.bin   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.hdr   binary
